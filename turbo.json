{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "vite.config.ts"],
  "tasks": {
    "clean": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
